# API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
#  LLM 协议选择（默认 anthropic）
#
#  LLM_PROTOCOL=openai 时走 OpenAI 兼容端点（Chat Completions，流式+tool_calls）：
#    LLM_PROTOCOL=openai
#    OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 百炼
#    OPENAI_API_KEY=sk-xxx                                               # 缺省回退 ANTHROPIC_API_KEY
#    MODEL_ID=qwen3.8-max
#  其它兼容端点：https://api.openai.com/v1 、vLLM / Ollama 的 /v1 等。
# =============================================================================
# LLM_PROTOCOL=anthropic
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Sampling parameters (optional)
# TEMPERATURE=0.5
# TOP_P=0.9
# STOP_SEQUENCES=

# Extra read-only roots (optional). PATH-style separator (';' on Windows, ':' on POSIX).
# read_file/glob/grep/list_files may read these dirs OUTSIDE the workspace (front door),
# so cross-project reading no longer needs the bash back door. Writes stay workspace-only.
# EXTRA_READ_ROOTS=D:\gitcode\other-project\docs;/home/me/shared-docs

# =============================================================================
#  RAG 向量检索（可选，默认零依赖模式：本地哈希 embedding + 内存存储）
#
#  pgvector 模式（推荐，语义检索质量高）：
#    VECTOR_STORE=pg
#    PG_CONNECTION_STRING=postgres://postgres:password@localhost:5432/ai_agent
#    初始化: psql -U postgres -d ai_agent -f db/init.sql
#
#  OpenAI 兼容 embedding 端点（可选，缺省用本地哈希 embedding）：
#    EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#    EMBEDDING_API_KEY=sk-xxx
#    EMBEDDING_MODEL=BAAI/bge-m3
# =============================================================================
# VECTOR_STORE=memory
# PG_CONNECTION_STRING=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# =============================================================================
#  Anthropic-compatible providers
#
#  Provider         MODEL_ID                    Notes                 Base URL
#  ---------------  --------------------------  --------------------  -------------------
#  Anthropic        claude-sonnet-4-6           default               (default)
#  MiniMax          MiniMax-M3                  latest M-series       see below
#  GLM (Zhipu)      glm-5.2                     latest coding model   see below
#  Kimi (Moonshot)  kimi-k2.7-code              coding model          see below
#  DeepSeek         deepseek-v4-pro             pro model             see below
#                   deepseek-v4-flash           flash model           see below
#
#  Check provider docs for current availability, pricing, and regional access.
# =============================================================================

# ---- International ----

# MiniMax          https://www.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM (Zhipu)      https://z.ai
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5.2

# Kimi (Moonshot)  https://platform.kimi.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek         https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# ---- China mainland ----

# MiniMax          https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM (Zhipu)      https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5.2

# Kimi (Moonshot)  https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek (no regional split, same endpoint globally)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# =============================================================================
#  权限与安全（可选）
#
#  PERMISSION_MODE: ask（默认，逐项询问）/ auto（仅明确 safe 自动放行）/
#                   deny（拒绝一切需审批操作）/ bypass（显式全放行，危险！仅限隔离环境）
#  YOLO=1          : auto 模式下启用 LLM 自动审批分类器（unsafe 仍转人工）
#  DOCKER_SANDBOX=1: bash 命令送进 Docker 容器执行（隔离文件系统/网络/进程）
#  WEB_ALLOWED_HOSTS: web 抓取公网白名单（逗号分隔）；非空时仅放行名单内主机
#  ANVIL_LANG      : 界面语言 zh / en
# =============================================================================
# PERMISSION_MODE=ask
# YOLO=0
# DOCKER_SANDBOX=0
# WEB_ALLOWED_HOSTS=
# ANVIL_LANG=zh

# ---- 执行效率护栏（可选） ----
# 所有 MAX_* / SUBAGENT_* 数值字段统一语义：
#   缺省  = 使用默认值
#   0     = 不限制（无上限）
#   负数  = 禁用（例如 MAX_TOOL_CALLS_PER_RUN=-1 表示不允许任何工具调用）
# 同一工具调用连续执行上限（超过即拦截，防对失败命令盲目重试）
# MAX_REPEAT_TOOL_CALLS=2
# 单次 run 工具调用上限（80% 预警）
# MAX_TOOL_CALLS_PER_RUN=80
# 单次 run LLM 调用次数上限
# MAX_LLM_CALLS_PER_RUN=40
# 单次 run 输出 token 预算（80% 预警）
# MAX_RUN_OUTPUT_TOKENS=200000
# 单次 run 输入 token 预算（请求前检查）
# MAX_RUN_INPUT_TOKENS=400000
# 单次 run 总 token 预算（输入+输出，请求前检查）
# MAX_RUN_TOTAL_TOKENS=500000
# 重试退避基础延迟（毫秒，缺省指数退避；测试加速用）
# RETRY_DELAY_MS=

# ---- 子 Agent 成本预算（可选） ----
# 单任务 subagent 数量上限（0=不限制）
# MAX_SUBAGENTS_PER_TASK=3
# 每个 subagent 独立预算
# SUBAGENT_MAX_TURNS=12
# SUBAGENT_MAX_TOOL_CALLS=15
# SUBAGENT_MAX_LLM_CALLS=12
# SUBAGENT_MAX_OUTPUT_TOKENS=100000
# SUBAGENT_MAX_INPUT_TOKENS=200000
# SUBAGENT_MAX_TOTAL_TOKENS=250000
# subagent wall-clock 超时（毫秒）
# SUBAGENT_TIMEOUT_MS=300000
# 父任务全部 subagent 的聚合成本预算
# SUBAGENT_TOTAL_TOOL_CALLS=40
# SUBAGENT_TOTAL_OUTPUT_TOKENS=400000

# ---- 先规划再执行（Plan-and-Execute，可选） ----
# AUTO_PLAN=1        : 强制大任务先规划再执行（1/true 强制，0/false 关闭，缺省=启发式：长输入+多步骤标记才规划）
# PLAN_THRESHOLD_CHARS=160 : 触发规划的输入长度阈值（启发式模式）
# PLAN_MAX_STEPS=8         : 规划步骤数上限
# AUTO_PLAN=
# PLAN_THRESHOLD_CHARS=160
# PLAN_MAX_STEPS=8

